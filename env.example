# ── Required ──────────────────────────────────────────────────────────────
# Get this from @BotFather on Telegram
TELEGRAM_TOKEN=YOUR_BOT_TOKEN_HERE

# ── Optional (bot works fine without these, using free public endpoints) ───
COINGECKO_API_KEY=
NEWSAPI_KEY=

# ── Branding — customize these when white-labeling / reselling this bot ────
WEBSITE_URL=https://dtc-official.vercel.app
CREATOR_USERNAME=philemon4u
BOOKING_URL=https://bookmei.vercel.app/

# ── Deployment ───────────────────────────────────────────────────────────
# Render/Railway/Heroku-style platforms set this automatically. Only needed
# locally if you want to test the keep-alive health-check server.
PORT=10000

# Path to the SQLite database file (leave default unless you know you need to change it)
DB_PATH=bot_data.db
